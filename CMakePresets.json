{
    "version": 6,

    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default",
            "binaryDir": "${sourceDir}/build/default",
            "cacheVariables": {
                "BUILD_TESTING": "OFF"
            }
        },
        {
            "name": "tests",
            "displayName": "Tests",
            "binaryDir": "${sourceDir}/build/tests",
            "cacheVariables": {
                "BUILD_TESTING": "ON"
            }
        }
    ],

    "buildPresets": [
        {
            "name": "default",
            "displayName": "Build Default",
            "configurePreset": "default",
            "configuration": "Debug"
        },
        {
            "name": "tests",
            "displayName": "Build Tests",
            "configurePreset": "tests",
            "configuration": "Debug"
        },
        {
            "name": "tests-clean",
            "displayName": "Build Tests (Clean)",
            "configurePreset": "tests",
            "configuration": "Debug",
            "cleanFirst": true
        }
    ],

    "testPresets": [
        {
            "name": "tests",
            "displayName": "Run Tests",
            "configurePreset": "tests",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
